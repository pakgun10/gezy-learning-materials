# Contoh konfigurasi environment Gezy Learning Materials.
# Salin menjadi .env ATAU pasang sebagai Environment= di file systemd
# (lihat deploy/gezy-materials.service). Jangan commit file .env asli!

# Port aplikasi (diakses nginx via reverse proxy)
PORT=3020

# Folder data (database SQLite + file unggahan). Pisahkan dari folder kode
# agar aman saat update dengan git pull.
DATA_DIR=/var/lib/gezy-learning-materials

# 1 = cookie sesi hanya dikirim via HTTPS (wajib 1 di production)
COOKIE_SECURE=1

# Batas ukuran unggahan (MB). Samakan dengan client_max_body_size di nginx.
MAX_UPLOAD_MB=500

# Rate limit login: maks percobaan gagal per IP per jendela waktu
LOGIN_MAX_FAIL=10
LOGIN_WINDOW_MIN=10
